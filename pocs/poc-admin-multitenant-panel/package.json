{
  "name": "poc-admin-multitenant-panel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PoC: painel de administração multi-instituição (master da plataforma, master da instituição, autor, tutor) com navegação lateral, tabelas com busca e paginação, formulários validados, confirmação de ações destrutivas, modo escuro, celular e i18n, sem biblioteca de componentes",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "verify": "eslint . && tsc --noEmit && vitest run --reporter=verbose && node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^24",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
