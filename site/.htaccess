# .htaccess da raiz do /labs (copiado para _site/ pelo scripts/build-site.sh)

Options -Indexes
DirectoryIndex index.html index.php

# --- Só public/ e dist/ de cada poc/spike/benchmark ficam acessíveis (o catálogo fica em catalogo/) ---
# (o build também grava "Require all denied" em cada pasta bloqueada, para o caso de mod_rewrite estar desligado)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteRule ^(pocs|spikes|benchmarks)/[^/]+/(public|dist)(/|$) - [L]
    RewriteRule ^(pocs|spikes|benchmarks)/ - [F]
</IfModule>

# --- Arquivos sensíveis ---
<FilesMatch "(\.env\.php|\.env|\.ftp-deploy-sync-state\.json)$">
    Require all denied
</FilesMatch>
# Log do PHP gravado na pasta do script (ex.: */public/error_log): nunca público
<FilesMatch "^error_log$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.(git|ht)">
    Require all denied
</FilesMatch>

# --- Headers de segurança ---
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By

    # --- Cache: nenhum visitante deve ver versão antiga depois de um deploy ---
    # Arquivos SEM hash no nome (HTML do catálogo e das demos, CSS do site, saída do CI, JSON):
    # sempre revalidados com o servidor (no-cache = usa o cache só se não mudou).
    <FilesMatch "\.(html|css|txt|json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Assets gerados pelo Vite nas demos têm hash no nome: podem ficar em cache por 1 ano.
    <If "%{REQUEST_URI} =~ m#/dist/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
