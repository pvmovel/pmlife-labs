# .htaccess da raiz do /labs (copiado para _site/ pelo scripts/build-site.sh)

Options -Indexes
DirectoryIndex index.html index.php

# --- Só public/ e dist/ de cada poc/spike/benchmark ficam acessíveis (o catálogo fica em catalogo/) ---
# (o build também grava "Require all denied" em cada pasta bloqueada, para o caso de mod_rewrite estar desligado)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    RewriteRule ^(pocs|spikes|benchmarks)/[^/]+/(public|dist)(/|$) - [L]
    RewriteRule ^(pocs|spikes|benchmarks)/ - [F]
</IfModule>

# --- Arquivos sensíveis ---
<FilesMatch "(\.env\.php|\.env|\.ftp-deploy-sync-state\.json)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.(git|ht)">
    Require all denied
</FilesMatch>

# --- Headers de segurança ---
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>
