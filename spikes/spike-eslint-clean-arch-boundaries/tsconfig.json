{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["src/Domain/*"],
      "@application/*": ["src/Application/*"],
      "@infrastructure/*": ["src/Infrastructure/*"],
      "@presentation/*": ["src/Presentation/*"],
      "@content/*": ["src/Content/*"]
    }
  },
  "include": ["src", "violations"]
}
