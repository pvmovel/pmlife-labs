{
  "description": "Nível exigindo atributo e fase que não existem.",
  "base": "course",
  "mutations": [
    {
      "op": "set",
      "path": "/levels/1/minAttributes",
      "value": {
        "comunicacao": 3
      }
    },
    {
      "op": "set",
      "path": "/levels/1/requiredPhases",
