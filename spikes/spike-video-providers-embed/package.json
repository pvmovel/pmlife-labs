{
  "name": "spike-video-providers-embed",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Spike: o totem de vídeo além do YouTube (Vimeo, Panda Video e Bunny Stream), uma estratégia por plataforma (Open/Closed): links aceitos, IDs guardados, endereço do player com o mínimo de rastreamento e o protocolo de pronto e erro por postMessage, medidos com os players reais no Chrome",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "measure": "node --no-warnings scripts/measure.mjs",
    "verify": "eslint . && tsc --noEmit && vitest run --reporter=verbose"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^24",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^24",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
